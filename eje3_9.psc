Algoritmo eje3_9
	Definir a Como Real
	Escribir "Ingrese la nota definitiva entre 0.0 a 5.0"
	Leer a
	si a<3.0
		Escribir "Insuficiente"
	SiNo
		si a<=3.5
			Escribir "Aceptable"
		SiNo
			si a<=4.0
				Escribir "Sobresaliente"
			SiNo
				Escribir "Excelente"
			FinSi
		FinSi
	FinSi
FinAlgoritmo
