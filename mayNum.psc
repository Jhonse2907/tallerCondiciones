Algoritmo mayNum
	definir a, b Como Entero
	Escribir "Ingrese el primer número"
	Leer a
	Escribir "Ingrese el segundo número"
	Leer b
	si a>b
		Escribir "El número ",a " es mayor que ",b
	SiNo
		Si b>a
			Escribir "El número ",a " es menor que ",b
			
		SiNo
			
		Escribir "Ambos numeros son iguales"
		FinSi
	FinSi
FinAlgoritmo
