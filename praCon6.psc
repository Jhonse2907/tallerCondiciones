Algoritmo praCon6
	Definir a, b, c Como Entero
	Escribir "Ingrese el valor minimo del intervalo"
	Leer a
	Escribir "Ingrese el valor maximo del intervalo"
	Leer b
	Escribir "Ingrese el número a validar"
	Leer c
	si c>=a Y c<=b 
		Escribir "El número se encuentra en el rango"
	SiNo
		Escribir "El número no se encuentra en el rango"
	FinSi
FinAlgoritmo
